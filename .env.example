DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
# Web app (Phase 5). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Encrypts users' API keys: if it changes, users must re-enter their keys.
APP_SECRET_KEY=
# Optional: the server's own key, used by the CLI/eval and by accounts with `server-key on`.
ANTHROPIC_API_KEY=
# Optional: creates (or promotes) the first admin at startup. Get both lines from
#   python -m api.admin export-login <your-username>
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
